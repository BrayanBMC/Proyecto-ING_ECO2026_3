{
  "name": "amortiza",
  "private": true,
  "version": "0.1.0",
  "description": "Amortiza: simulador académico de créditos e ingeniería económica en pesos colombianos.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@neondatabase/neon-js": "0.9.0-beta",
    "decimal.js": "^10.6.0",
    "pdfmake": "0.3.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "zod": "$zod",
    "@neondatabase/auth": {
      "better-auth": "1.7.14",
      "@better-auth/core": "1.7.14",
      "@better-auth/oauth-provider": "1.7.14",
      "better-call": "1.4.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/pdfmake": "0.2.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  }
}
